# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/online-judge

# Secret used to sign/verify JWTs. Use a long, random value in production
# (e.g. `openssl rand -hex 32`). The server refuses to start without this.
JWT_SECRET=change-this-to-a-long-random-string

# Port the backend listens on
PORT=8080

# Set to "production" on deployed environments (enables secure cookies)
NODE_ENV=development

# Leave unset in every normal deployment (EC2, local dev with Docker) - the
# app defaults to running submissions in the real Docker sandbox
# (utils/dockerSandbox.js). Only set this to "host" on a hosting platform
# that does not provide a Docker daemon (e.g. a free-tier demo host), which
# falls back to running submitted code directly on the host process with NO
# isolation. See utils/hostFallbackExecutor.js for details before using this.
# EXECUTION_BACKEND=host
