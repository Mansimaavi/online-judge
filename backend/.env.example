# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/online-judge

# Secret used to sign/verify JWTs. Use a long, random value in production
# (e.g. `openssl rand -hex 32`). The server refuses to start without this.
JWT_SECRET=change-this-to-a-long-random-string

# Port the backend listens on
PORT=8080

# Set to "production" on deployed environments (enables secure cookies)
NODE_ENV=development
